# ============================================================
# tpl-app-web 环境变量样例（复制为 .env 后使用）
# .env 不入库；本样例仅提供简单占位值
# ============================================================

# RSA 公钥（与后端 RSA_PRIVATE_KEY 对应）
VITE_APP_RSA_PUBLIC_KEY=changeMe

# 微信登录开关（默认启用）
VITE_APP_WECHAT_LOGIN_ENABLED=false

# 客户端标识
VITE_APP_CLIENT_ID=web
